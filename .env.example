# KinSync / CareLoop configuration. DOCUMENTATION ONLY: nothing loads this file automatically.
# Export the variables you need in your shell. The default demo (pnpm demo) needs none of them.

# MCP server
PORT=3333                                   # MCP endpoint port (http://127.0.0.1:$PORT/mcp)
CARELOOP_DB=data/careloop.db                # SQLite file (pnpm demo uses data/kinsync-demo.db)
CARELOOP_CORS_ORIGINS=                      # comma-separated browser origins, e.g. http://localhost:8080 for the reference host
CARELOOP_DEFAULT_ACTOR=                     # synthetic member id for sessions without X-CareLoop-Actor (browser hosts), e.g. mem_priya
CARELOOP_SIMULATED_ACTORS=0                 # 1 = DEMO ONLY labeled simulated-identity switcher for header-less sessions. Not authentication.

# CLI client
MCP_URL=http://127.0.0.1:3333/mcp
CARELOOP_ACTOR=mem_ravi                     # synthetic member id the CLI acts as

# Optional, experimental, local and free
OLLAMA_MODEL=llama3.1                       # model already pulled into a local Ollama daemon

# Optional, PAID, never used by the demo or tests. Leave unset unless you explicitly run `pnpm eval:live -- --live`.
# ANTHROPIC_API_KEY=
